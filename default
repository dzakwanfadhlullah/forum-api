# Konfigurasi Nginx Server Block (/etc/nginx/sites-available/default)
# Menerapkan Limit Access menggunakan Nginx untuk Menghindari DDoS Attack

# Definisi zona limit_req: 90 requests per menit (rate=90r/m)
limit_req_zone $binary_remote_addr zone=threads_limit:10m rate=90r/m;
limit_req_status 429;

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    # Proxy headers standar
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Limit Access pada endpoint /threads dan seluruh endpoint turunannya:
    # - POST   /threads
    # - GET    /threads/:id
    # - POST   /threads/:id/comments
    # - DELETE /threads/:id/comments/:commentId
    # - POST   /threads/:id/comments/:commentId/replies
    # - DELETE /threads/:id/comments/:commentId/replies/:replyId
    # - PUT    /threads/:id/comments/:commentId/likes
    location /threads {
        limit_req zone=threads_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # Endpoint umum lainnya (/users, /authentications, /)
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }
}
